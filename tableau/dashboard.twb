      <aliases enabled='yes' />
      <column caption='Total Customers' datatype='integer' name='[Calculation_1438220489220096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_1438220489330689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [churn_flag] = 1 THEN [customer_id] END)' />
      </column>
      <column caption='Retained Customers' datatype='integer' name='[Calculation_1438220489613314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [churn_flag] = 0 THEN [customer_id] END)' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_1438220489728003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1438220489220096] = 0 THEN 0&#13;&#10;ELSE [Calculation_1438220489330689] / [Calculation_1438220489220096]&#13;&#10;END' />
      </column>
      <column caption='Total Monthly Charges' datatype='real' name='[Calculation_1438220489859076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_charges])' />
      </column>
      <column caption='Average Monthly Charges' datatype='real' name='[Calculation_1438220489973765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([monthly_charges])' />
      </column>
      <column caption='Missing Total Charges' datatype='integer' name='[Calculation_1438220490072070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([total_charges]) THEN [customer_id] END)' />
